# Never put a trailing comment on a line in this file: Docker Compose would read it as
# part of the value. An empty variable falls back to its default. On startup, TechPulse
# lists everything that is missing or invalid at once.

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Provider: anthropic, openai or gemini.
LLM_PROVIDER=anthropic
# REQUIRED. API key of the selected provider.
LLM_API_KEY=

# Optional. Leave empty to use the provider defaults (see the README).
#   LLM_TOPIC_MODEL    turns a sentence into a structured topic. Rarely called, but its
#                      output drives all the scoring: keep a strong model here.
#   LLM_SCORING_MODEL  scores every article, every day. This one drives the bill.
# When switching providers, update or clear these two values as well.
LLM_TOPIC_MODEL=
LLM_SCORING_MODEL=

# ─── Channels ─────────────────────────────────────────────────────────────────
# REQUIRED. Comma-separated output channels. Available: discord.
CHANNELS=discord

# ─── Discord (when CHANNELS contains discord) ─────────────────────────────────
# REQUIRED. Token of the bot. It creates one channel per topic, then receives the
# /topic and /run commands.
DISCORD_BOT_TOKEN=

# REQUIRED. Comma-separated Discord user IDs allowed to control the bot. Without this
# list, anyone on the server could add topics and spend your API quota.
# To get your ID: Discord settings › Advanced › Developer Mode, then right-click your
# username › Copy User ID.
DISCORD_ALLOWED_USER_IDS=

# Optional. Server where the channels are created. Only needed when the bot is on
# several servers (right-click the server › Copy Server ID).
DISCORD_GUILD_ID=

# ─── Sources ──────────────────────────────────────────────────────────────────
# Articles published more than N days ago are ignored.
MAX_ITEM_AGE_DAYS=7

# ─── Digest ───────────────────────────────────────────────────────────────────
# Minimum score out of 10 for an article to make it into the digest.
DIGEST_SCORE_THRESHOLD=6
# Language used by the LLM for summaries and topics (English, French, Japanese…).
DIGEST_LANGUAGE=English
# Maximum number of articles per digest; the overflow is postponed to the next one.
DIGEST_MAX_ITEMS=25

# ─── Schedule (cron syntax, in the TZ time zone) ──────────────────────────────
TZ=Europe/Paris
CRON_COLLECT=0 */2 * * *
CRON_SCORE=20 */2 * * *
CRON_DIGEST=0 8 * * *

# ─── Tuning ───────────────────────────────────────────────────────────────────
# Articles sent to the model per call. Larger means fewer and cheaper calls, but a
# longer response and a higher risk of truncated output.
AI_BATCH_SIZE=8
AI_MAX_ATTEMPTS=3
AI_MAX_ITEMS_PER_RUN=60
# When a topic is added, articles fetched in the last N hours and not sent yet are
# scored again against the updated topics. 0 disables it.
AI_RESCORE_WINDOW_HOURS=48
LOG_LEVEL=info
