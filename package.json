{
  "name": "techpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal tech watch: collects articles, scores them with an LLM and posts a daily digest to Discord.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "setup": "npm ci && npm run rebuild:native",
    "rebuild:native": "npm rebuild better-sqlite3 --ignore-scripts=false",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "tsc && node --test --test-reporter=spec \"dist/tests/**/*.test.js\"",
    "audit:deps": "npm audit signatures --min-release-age=0 && npm audit --min-release-age=0",
    "check": "npm run lint && npm run audit:deps && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@google/genai": "2.22.0",
    "better-sqlite3": "12.11.1",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "htmlparser2": "12.0.0",
    "node-cron": "4.6.0",
    "openai": "7.15.0",
    "rss-parser": "3.13.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
